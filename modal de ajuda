<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Navegue Seguro - Guia de Segurança Digital</title>
  
  <style>
    /* Reset básico e variáveis de cores acessíveis */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --cor-fundo: #f0f4f8;
      --cor-cartao: #ffffff;
      --cor-texto: #1a202c;
      --cor-primaria: #004b87;
      --cor-primaria-hover: #003366;
      --cor-destaque: #d9381e;
      --cor-alerta-fundo: #fff9e6;
      --cor-alerta-borda: #b37400;
      --cor-sucesso-fundo: #e6f4ea;
      --cor-sucesso-borda: #137333;
      --tamanho-fonte-base: 22px;
      --tamanho-fonte-titulo: 32px;
      --espacamento-padrao: 20px;
    }

    /* Esconde seletores de estado (checkbox/radio ocultos para lógica pura em CSS) */
    .seletor-estado {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    /* Regras do Modo Alto Contraste */
    #toggle-contraste:checked ~ .aplicacao {
      --cor-fundo: #000000;
      --cor-cartao: #121212;
      --cor-texto: #ffffff;
      --cor-primaria: #ffff00;
      --cor-primaria-hover: #e6e600;
      --cor-destaque: #ff6666;
      --cor-alerta-fundo: #332600;
      --cor-alerta-borda: #ffff00;
      --cor-sucesso-fundo: #003311;
      --cor-sucesso-borda: #00ff66;
    }

    /* Regras para Aumento de Fonte */
    #toggle-fonte:checked ~ .aplicacao {
      --tamanho-fonte-base: 26px;
      --tamanho-fonte-titulo: 38px;
    }

    /* Estilo do corpo da página */
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #dbe2e9;
      color: #1a202c;
      line-height: 1.6;
      padding: 10px;
    }

    .aplicacao {
      max-width: 900px;
      margin: 0 auto;
      background-color: var(--cor-fundo);
      color: var(--cor-texto);
      border-radius: 16px;
      padding: var(--espacamento-padrao);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      font-size: var(--tamanho-fonte-base);
      transition: background-color 0.3s, color 0.3s;
    }

    /* Barra de acessibilidade topo */
    .barra-acessibilidade {
      background-color: var(--cor-cartao);
      border: 3px solid var(--cor-primaria);
      border-radius: 12px;
      padding: 15px;
      margin-bottom: 25px;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: space-around;
      align-items: center;
    }

    .botao-acessibilidade {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background-color: var(--cor-primaria);
      color: #ffffff;
      padding: 14px 20px;
      border-radius: 10px;
      font-size: 20px;
      font-weight: bold;
      cursor: pointer;
      border: 3px solid transparent;
      user-select: none;
    }

    #toggle-contraste:checked ~ .aplicacao .botao-acessibilidade {
      color: #000000;
    }

    .botao-acessibilidade:hover,
    .botao-acessibilidade:focus-within {
      outline: 4px solid #ffbf00;
    }

    /* Cabeçalho */
    header {
      text-align: center;
      margin-bottom: 30px;
      border-bottom: 4px solid var(--cor-primaria);
      padding-bottom: 20px;
    }

    header h1 {
      font-size: var(--tamanho-fonte-titulo);
      color: var(--cor-primaria);
      margin-bottom: 10px;
    }

    header p {
      font-weight: bold;
    }

    /* Navegação por Abas */
    .navegacao-abas {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 25px;
    }

    .aba-rotulo {
      flex: 1 1 200px;
      text-align: center;
      background-color: var(--cor-cartao);
      color: var(--cor-texto);
      border: 3px solid var(--cor-primaria);
      padding: 16px var(--espacamento-padrao);
      border-radius: 12px;
      font-size: var(--tamanho-fonte-base);
      font-weight: bold;
      cursor: pointer;
      user-select: none;
    }

    .aba-rotulo:hover {
      background-color: var(--cor-primaria);
      color: #ffffff;
    }

    #toggle-contraste:checked ~ .aplicacao .aba-rotulo:hover {
      color: #000000;
    }

    /* Mostrar aba selecionada via seletor :checked */
    #aba-dicas:checked ~ .aplicacao label[for="aba-dicas"],
    #aba-dicionario:checked ~ .aplicacao label[for="aba-dicionario"],
    #aba-quiz:checked ~ .aplicacao label[for="aba-quiz"],
    #aba-socorro:checked ~ .aplicacao label[for="aba-socorro"] {
      background-color: var(--cor-primaria);
      color: #ffffff;
      outline: 4px solid #ffbf00;
    }

    #toggle-contraste:checked ~ .aplicacao #aba-dicas:checked ~ .aplicacao label[for="aba-dicas"],
    #toggle-contraste:checked ~ .aplicacao #aba-dicionario:checked ~ .aplicacao label[for="aba-dicionario"],
    #toggle-contraste:checked ~ .aplicacao #aba-quiz:checked ~ .aplicacao label[for="aba-quiz"],
    #toggle-contraste:checked ~ .aplicacao #aba-socorro:checked ~ .aplicacao label[for="aba-socorro"] {
      color: #000000;
    }

    /* Esconder todos os painéis por padrão */
    .painel-conteudo {
      display: none;
    }

    /* Exibir apenas o painel ativo */
    #aba-dicas:checked ~ .aplicacao #painel-dicas,
    #aba-dicionario:checked ~ .aplicacao #painel-dicionario,
    #aba-quiz:checked ~ .aplicacao #painel-quiz,
    #aba-socorro:checked ~ .aplicacao #painel-socorro {
      display: block;
    }

    /* Cartões e Blocos de Conteúdo */
    .cartao {
      background-color: var(--cor-cartao);
      border: 3px solid var(--cor-primaria);
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 25px;
    }

    .cartao h2, .cartao h3 {
      color: var(--cor-primaria);
      margin-bottom: 12px;
      font-size: calc(var(--tamanho-fonte-base) + 4px);
    }

    .cartao p {
      margin-bottom: 15px;
    }

    /* Caixa de Alerta amarela/escura */
    .caixa-alerta {
      background-color: var(--cor-alerta-fundo);
      border-left: 8px solid var(--cor-alerta-borda);
      padding: 16px;
      border-radius: 6px;
      margin-top: 15px;
      font-weight: bold;
    }

    /* Caixa de Sucesso verde/escura */
    .caixa-sucesso {
      background-color: var(--cor-sucesso-fundo);
      border-left: 8px solid var(--cor-sucesso-borda);
      padding: 16px;
      border-radius: 6px;
      margin-top: 15px;
      font-weight: bold;
    }

    /* Dicionário expansível (usando HTML5 details/summary) */
    details {
      background-color: var(--cor-cartao);
      border: 2px solid var(--cor-primaria);
      border-radius: 10px;
      margin-bottom: 15px;
      padding: 12px;
    }

    summary {
      font-weight: bold;
      font-size: calc(var(--tamanho-fonte-base) + 2px);
      color: var(--cor-primaria);
      cursor: pointer;
      padding: 8px;
    }

    summary:hover, summary:focus {
      background-color: rgba(0, 75, 135, 0.1);
      border-radius: 6px;
    }

    details p {
      margin-top: 12px;
      padding-left: 8px;
    }

    /* Estilos do Quiz */
    .pergunta-quiz {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 2px dashed var(--cor-primaria);
    }

    .opcao-quiz {
      display: block;
      background-color: var(--cor-fundo);
      border: 2px solid var(--cor-primaria);
      padding: 14px;
      border-radius: 10px;
      margin-top: 10px;
      cursor: pointer;
    }

    .opcao-quiz:hover {
      outline: 3px solid #ffbf00;
    }

    .resposta-feedback {
      display: none;
      margin-top: 10px;
      padding: 12px;
      border-radius: 8px;
      font-weight: bold;
    }

    /* Lógica do Quiz com CSS puro */
    #q1-correta:checked ~ #f1-correto,
    #q1-errada:checked ~ #f1-errado,
    #q2-correta:checked ~ #f2-correto,
    #q2-errada:checked ~ #f2-errado {
      display: block;
    }

    /* Botões grandes de ação */
    .btn-ligar {
      display: block;
      width: 100%;
      background-color: var(--cor-destaque);
      color: #ffffff;
      text-align: center;
      font-weight: bold;
      font-size: calc(var(--tamanho-fonte-base) + 2px);
      padding: 20px;
      text-decoration: none;
      border-radius: 12px;
      margin-top: 15px;
      border: none;
    }

    .btn-ligar:hover, .btn-ligar:focus {
      outline: 5px solid #ffbf00;
    }

    /* Rodapé */
    footer {
      text-align: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 2px solid var(--cor-primaria);
      font-size: 18px;
    }
  </style>
</head>
